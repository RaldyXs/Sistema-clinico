# ==============================================================================
# Dockerfile para Frontend (@sistema-clinico/web)
# Multi-stage build: Compilación con Vite + Servidor ligero Nginx Alpine
# ==============================================================================

# --- Etapa 1: Compilación de la App React ---
FROM node:22-bookworm-slim AS builder

WORKDIR /app

# Copiamos manifiestos del monorepo
COPY package.json package-lock.json ./
COPY apps/web/package.json ./apps/web/
COPY apps/api/package.json ./apps/api/

# Instalamos dependencias
RUN npm ci

# Copiamos archivos de configuración y código fuente de la web
COPY apps/web ./apps/web

# Por defecto en producción Docker, la API se consume a través de la ruta relativa /api
# que Nginx redirige internamente hacia el contenedor NestJS sin problemas de CORS.
ARG VITE_API_URL=/api
ENV VITE_API_URL=$VITE_API_URL

# Compilamos la aplicación para producción (TypeScript + Vite)
RUN npm run build --workspace=@sistema-clinico/web

# --- Etapa 2: Servidor Nginx ---
FROM nginx:alpine AS runner

# Copiamos nuestra configuración optimizada de Nginx
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copiamos el bundle estático compilado
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
