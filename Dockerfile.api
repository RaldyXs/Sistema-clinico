# ==============================================================================
# Dockerfile para Backend (@sistema-clinico/api)
# Multi-stage build optimizado para producción en Debian 12 / Proxmox
# ==============================================================================

# --- Etapa 1: Compilación ---
FROM node:22-bookworm-slim AS builder

WORKDIR /app

# Copiamos manifiestos del monorepo
COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/

# Instalamos todas las dependencias
RUN npm ci

# Copiamos código fuente del backend
COPY apps/api ./apps/api

# Compilamos la API con NestJS
RUN npm run build --workspace=@sistema-clinico/api

# --- Etapa 2: Imagen de Producción Slim ---
FROM node:22-bookworm-slim AS runner

WORKDIR /app

ENV NODE_ENV=production

# Copiamos manifiestos e instalamos únicamente dependencias de producción
COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/

RUN npm ci --omit=dev && npm cache clean --force

# Copiamos los archivos JavaScript ya compilados
COPY --from=builder /app/apps/api/dist ./apps/api/dist

# Directorio persistente para adjuntos clínicos y respaldos
RUN mkdir -p /app/uploads && chown -R node:node /app/uploads

USER node

EXPOSE 3000

CMD ["node", "apps/api/dist/main.js"]
