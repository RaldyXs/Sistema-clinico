# ========================================================
# CONFIGURACIÓN DE ENTORNO — SISTEMA CLÍNICO SAAS
# ========================================================
# Copia este archivo a '.env' y completa con tus valores reales de producción.

# Entorno de Ejecución (development | production)
NODE_ENV=production

# Puertos Internos
API_PORT=3000
WEB_PORT=5173

# Base de Datos PostgreSQL
DATABASE_URL=postgresql://clinico_user:TU_PASSWORD_SEGURO@127.0.0.1:5432/sistema_clinico
DB_SSL=false

# Criptografía y Sesiones JWT (¡CAMBIAR EN PRODUCCIÓN!)
JWT_SECRET=genera_un_secreto_aleatorio_muy_largo_de_al_menos_64_caracteres
JWT_EXPIRES_IN=24h

# Seguridad Web y Orígenes Permitidos (CORS)
# Separa por comas si tienes múltiples dominios autorizados
CORS_ORIGINS=https://app.tudominio.com,https://admin.tudominio.com

# URL pública de la API consumida por el Frontend (Vite)
VITE_API_URL=https://api.tudominio.com

# Credenciales del SuperAdmin (Dueño de la plataforma SaaS)
SUPERADMIN_EMAIL=superadmin@saas.com
SUPERADMIN_PASSWORD=CambiarEstaClaveSegura2026!

# Almacenamiento Persistente de Archivos y Estudios Médicos
UPLOAD_DIR=/var/data/sistema-clinico/uploads