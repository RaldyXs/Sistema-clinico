# Application
NODE_ENV=development

# Web
WEB_PORT=5173

# Puerto donde se ejecutará la API de NestJS.
# API
API_PORT=3000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Base de datos PostgreSQL utilizada por el sistema.
POSTGRES_DB=sistema_clinico
# Usuario utilizado para conectarse a PostgreSQL.
POSTGRES_USER=sistema_clinico
POSTGRES_PASSWORD=change_me

# Database connection
DATABASE_URL=postgresql://sistema_clinico:change_me@localhost:5432/sistema_clinico

# Notion Integration
NOTION_API_KEY=your_notion_internal_integration_secret
NOTION_ROADMAP_DATABASE_ID=your_notion_database_id

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=24h